{
  "name": "@pixelaid/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pixelaid": "./dist/bin.cjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').rmSync('dist/bin.js',{force:true})\" && esbuild src/bin.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/bin.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pixelaid/automation": "0.1.0",
    "@pixelaid/shared": "0.1.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0"
  }
}
