{
  "name": "@pixelaid/mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "pixelaid-mcp": "./dist/server.cjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/bin.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pixelaid/automation": "0.1.1",
    "@pixelaid/shared": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0"
  }
}
