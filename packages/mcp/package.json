{
  "name": "@pixelaid/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pixelaid-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pixelaid/automation": "0.1.0",
    "@pixelaid/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
